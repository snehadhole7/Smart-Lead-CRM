MONGODB_URI=mongodb://127.0.0.1:27017/smart_lead_crm
JWT_SECRET=change_this_secret
PORT=4000

# For local demos, show OTP in the browser instead of sending SMS/email.
# Set false in production after configuring SMTP/Twilio below.
OTP_DEMO_MODE=true

# Real email OTP delivery. For Gmail, use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
SMTP_FROM="Smart Lead CRM <your-email@gmail.com>"

# Real phone OTP delivery through Twilio.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+10000000000
